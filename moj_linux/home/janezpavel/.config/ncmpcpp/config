# vim: filetype=conf

ncmpcpp_directory = "~/.config/ncmpcpp"
mpd_music_dir = "~/glasba"
lyrics_directory = "~/glasba/besedila"
mpd_host = "127.0.0.1"
message_delay_time = "1"
visualizer_type = "spectrum"
visualizer_in_stereo = yes
song_list_format = "{$4%a - $9}{%t}|{$8%f$9}$R{$3(%l)$9}"                                         #določa format prikaza seznama pesmi. V tem primeru bo izpisal avtorja (%a), naslov pesmi (%t), format (%f), in dolžino (%l)
song_status_format = "$b{{$8'%t'}} $3by {$4%a{ $3in $7%b{ (%y)}} $3}|{$8%f}"                    #Nastavi format prikaza statusa trenutne pesmi. Prikazuje ime pesmi, avtorja, album (če obstaja), leto izida (%y) in format pesmi.
song_library_format = "{%n - }{%t}|{%f}"                                                        #Določa način prikaza pesmi v knjižnici, kjer %n predstavlja številko pesmi, %t naslov pesmi, %f pa format pesmi
alternative_header_first_line_format = "$b$1$aqqu$/a$9 {%t}|{%f} $1$atqq$/a$9$/b"               #Format za prvo vrstico alternativnega naslova v ncmpcpp, ki vključuje oblikovanje znotraj HTML tagov ($1, $9 itd.)
alternative_header_second_line_format = "{{$4$b%a$/b$9}{ - $7%b$9}{ ($4%y$9)}}|{%D}"            #Format za drugo vrstico alternativnega naslova, prikazuje avtorja, album in leto izida
colors_enabled = yes
#song_columns_list_format = "(30)[green]{a} (30)[magenta]{b} (30)[yellow]{t} (10)[blue]{l}"     #številke so širine v odstotkih; l-length, t-tittle, a-artist, b-album
main_window_color = "white"
#header_window_color = "green"                                                                  #podatki zgoraj
#volume_color = "green"
statusbar_color = "red"
empty_tag_color = "magenta"
progressbar_color = "black:b"
progressbar_elapsed_color = "blue:b"
progressbar_look = "->"
statusbar_time_color = "cyan:b"
current_item_prefix = "$(cyan)$r$b"
current_item_suffix = "$/r$(end)$/b"
current_item_inactive_column_prefix = "$(magenta)$r"
current_item_inactive_column_suffix = "$/r$(end)"
selected_item_prefix = "* "
discard_colors_if_item_is_selected = "yes"                                                      #izbrane vrstice so neobarvane
now_playing_prefix = ">> "
playlist_display_mode = "columns"
browser_display_mode = "columns"
search_engine_display_mode = "columns"
playlist_editor_display_mode = "columns"
media_library_primary_tag = "artist"
media_library_albums_split_by_date = no
startup_screen = "media_library"
display_volume_level = yes
ignore_leading_the = yes
external_editor = "gvim"
use_console_editor = yes
execute_on_player_state_change = "slstatus" #"sh ~/.local/bin/status-bar"
execute_on_song_change = "slstatus" #"sh ~/.local/bin/status-bar"
allow_for_physical_item_deletion = yes
follow_now_playing_lyrics = yes
#fetch_lyrics_for_current_song_in_background = yes
store_lyrics_in_song_dir = no
