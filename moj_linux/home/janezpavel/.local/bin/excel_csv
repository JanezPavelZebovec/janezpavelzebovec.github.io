#!/usr/bin/env python3

import pandas as pd
import sys
import openpyxl

# for v in sys.argv[1:]:
    # df = pd.read_excel(v, sheet_name='Sheet1')
    # df.to_csv(v.rsplit('.', 1)[0], index=False, encoding='utf-8')


for v in sys.argv[1:]:
    wb = openpyxl.load_workbook(v, read_only=True)
    sheets = wb.sheetnames
    wb.close()

    if len(sheets) == 1:
        chosen = sheets[0]
    else:
        print(f"\nDatoteka: {v}")
        for i, name in enumerate(sheets, start=1):
            print(f"  {i}) {name}")
        while True:
            izbira = input(f"Izberi list (1-{len(sheets)}): ").strip()
            if izbira.isdigit() and 1 <= int(izbira) <= len(sheets):
                chosen = sheets[int(izbira) - 1]
                break
            print("Neveljavna izbira, poskusi znova.")

    df = pd.read_excel(v, sheet_name=chosen)
    out_path = v.rsplit('.', 1)[0] + '.csv'
    df.to_csv(out_path, index=False, encoding='utf-8')
    print(f"Shranjeno: {out_path}  (list: {chosen})")
